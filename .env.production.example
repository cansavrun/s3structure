ENVIRONMENT=production
APP_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
DATABASE_URL=postgresql+psycopg://tenantfiles:REPLACE@YOUR_RDS_HOST:5432/tenantfiles?sslmode=verify-full&sslrootcert=/run/certs/rds-ca.pem
REDIS_URL=rediss://default:REPLACE@YOUR_REDIS_HOST:6379/0
PUBLIC_ORIGIN=https://files.example.com
ALLOWED_HOSTS=["files.example.com","localhost","api"]
AWS_REGION=eu-central-1
S3_MODE=sts
SESSION_TTL_SECONDS=3600
LOGIN_LIMIT_PER_MINUTE=10
REQUEST_LIMIT_PER_MINUTE=120
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY koymayın; ECS task role / workload identity kullanın.
