# Yalnızca standalone production compose + HOST üstünde güvenilir TLS proxy için.
# Gerçek Docker bridge gateway'ini doğrulayın. ECS/ALB için ayrı ağınıza uyarlayın.
# Bu dosya Nginx'in http context'inde /etc/nginx/conf.d/00-trusted-proxy.conf olarak mount edilir.
set_real_ip_from 172.29.72.1;
real_ip_header X-Forwarded-For;
real_ip_recursive on;
